rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validRoom(room) { return room in ['room1', 'room2', 'room3', 'room4', 'room5']; }
    function participant() {
      return request.auth != null &&
        (request.auth.uid == resource.data.whiteUid || request.auth.uid == resource.data.blackUid);
    }
    match /rooms/{roomId} {
      allow get: if validRoom(roomId);
      allow list: if false;
      allow create: if request.auth != null && validRoom(roomId) &&
        request.resource.data.keys().hasOnly(['whiteUid','blackUid','fen','pgn','updatedAt']) &&
        request.resource.data.whiteUid == request.auth.uid &&
        request.resource.data.blackUid == null;
      allow update: if request.auth != null && validRoom(roomId) &&
        request.resource.data.keys().hasOnly(['whiteUid','blackUid','fen','pgn','updatedAt']) &&
        request.resource.data.whiteUid == resource.data.whiteUid &&
        ((participant() && request.resource.data.blackUid == resource.data.blackUid) ||
         (resource.data.blackUid == null && request.resource.data.blackUid == request.auth.uid));
      allow delete: if false;
    }
  }
}